<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Blastlog.Playnite</AssemblyName>
    <RootNamespace>Blastlog.Playnite</RootNamespace>
    <!-- Screens may use XAML (docs/PLAYNITE_DESIGN.md); WPF builds need Windows (CI's Windows job and local Windows builds). -->
    <UseWPF>true</UseWPF>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <!-- The sync core is compiled into this one assembly, not shipped as its own DLL: Windows Smart App Control blocks an
         unsigned, never-seen DLL that Playnite loads by path (seen on a first real install). Fewer unsigned files, fewer
         blocks; code-signing is the real fix for a public release (docs/DECISIONS.md). The core keeps its own project for
         the Linux tests. -->
    <Compile Include="../Blastlog.Sync.Core/**/*.cs" Exclude="../Blastlog.Sync.Core/obj/**;../Blastlog.Sync.Core/bin/**" LinkBase="Core" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <!-- Playnite supplies its SDK at run time: compile against it, don't ship a copy. -->
    <PackageReference Include="PlayniteSDK" Version="6.18.0" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
    <Reference Include="System.Security" />
    <Reference Include="System.Net.Http" />
    <None Update="extension.yaml" CopyToOutputDirectory="PreserveNewest" />
    <!-- Outfit (SIL Open Font License, Fonts/OFL.txt), loaded by ThemeBridge so the Blastlog theme needs no installed font. -->
    <None Include="Fonts/*" CopyToOutputDirectory="PreserveNewest" />
    <None Update="icon.png" CopyToOutputDirectory="PreserveNewest" Condition="Exists('icon.png')" />
  </ItemGroup>
</Project>
