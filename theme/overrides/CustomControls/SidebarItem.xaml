<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      A Blastlog menu item (the site's .navigation a): icon and label, 13px gap, 13/14 padding, radius 12, muted text at
      14px weight 650; the selected and hovered item is filled with the page's game colour and its ink. Keyboard focus
      shows Blastlog's two-tone ring.
    -->
    <Style TargetType="{x:Type SidebarItem}">
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="{DynamicResource Blastlog.TextMuted}" />
        <Setter Property="Background" Value="Transparent" />
        <!-- Shown only for keyboard navigation (a mouse click doesn't show it). -->
        <Setter Property="FocusVisualStyle"><Setter.Value><Style><Setter Property="Control.Template"><Setter.Value><ControlTemplate><Border CornerRadius="14" BorderThickness="3" Margin="-3" BorderBrush="{DynamicResource Blastlog.Focus}" /></ControlTemplate></Setter.Value></Setter></Style></Setter.Value></Setter>
        <Setter Property="Height" Value="46" />
        <Setter Property="Margin" Value="0,0,0,5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="ToolTip" Value="{Binding Title}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type SidebarItem}">
                    <Grid>
                        <Border x:Name="Fill" Background="{TemplateBinding Background}" CornerRadius="12" />
                        <ProgressBar x:Name="PART_ProgressStatus" BorderThickness="0" Background="Transparent" Opacity="0.35"
                                     HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                        <DockPanel Margin="14,0,14,0">
                            <Viewbox Width="18" Height="18" DockPanel.Dock="Left" VerticalAlignment="Center">
                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                            </Viewbox>
                            <TextBlock x:Name="Label" Text="{Binding Title}" Margin="13,0,0,0" VerticalAlignment="Center"
                                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="38" LineHeight="18" LineStackingStrategy="BlockLineHeight" FontFamily="{DynamicResource FontFamily}"
                                       FontSize="14" FontWeight="SemiBold" Foreground="{TemplateBinding Foreground}" />
                        </DockPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Top">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="Label" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Bottom">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="Label" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Selected}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Blastlog.OnGame}" />
                <Setter Property="Background" Value="{DynamicResource Blastlog.Game}" />
            </DataTrigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Blastlog.OnGame}" />
                <Setter Property="Background" Value="{DynamicResource Blastlog.Game}" />
            </Trigger>
            <DataTrigger Binding="{Settings SidebarPosition}" Value="Top">
                <Setter Property="Width" Value="46" />
                <Setter Property="Margin" Value="0,0,5,0" />
            </DataTrigger>
            <DataTrigger Binding="{Settings SidebarPosition}" Value="Bottom">
                <Setter Property="Width" Value="46" />
                <Setter Property="Margin" Value="0,0,5,0" />
            </DataTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Content" Value="{x:Null}" />
                    <Condition Property="ContentTemplate" Value="{x:Null}" />
                </MultiTrigger.Conditions>
                <MultiTrigger.Setters>
                    <Setter Property="Background" Value="{DynamicResource Blastlog.Danger}" />
                </MultiTrigger.Setters>
            </MultiTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
