<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Blastlog's pick fields (design.md 7): 40px, surface with an edge, a chevron, and a surface card with highlight-only
         rows (no checkmarks). Based on Playnite's default theme (MIT, see CREDITS.md); every PART_ element is kept. -->

    <ControlTemplate x:Key="FilterSelectionBoxTemplate" TargetType="{x:Type FilterSelectionBoxBase}">
        <Border BorderThickness="{DynamicResource ControlBorderThickness}"
                CornerRadius="{DynamicResource ControlCornerRadius}"
                Style="{DynamicResource HighlightBorder}"
                Background="{DynamicResource Blastlog.Surface}"
                x:Name="Root">
            <Grid>
                <DockPanel>
                    <Viewbox Margin="0,0,12,0" Width="14" Height="14" DockPanel.Dock="Right">
                        <Canvas Width="24" Height="24">
                            <Path Stroke="{DynamicResource Blastlog.TextMuted}" StrokeThickness="2.4" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="m6 9 6 6 6-6" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock x:Name="PART_TextFilterString"
                               Style="{StaticResource BaseTextBlockStyle}"
                               TextTrimming="CharacterEllipsis" HorizontalAlignment="Stretch" 
                               VerticalAlignment="Center" DockPanel.Dock="Left"
                               Margin="14,0,0,0"/>
                </DockPanel>
                <ToggleButton x:Name="MainToggle"
                              BorderThickness="0" Focusable="False"
                              HorizontalContentAlignment="Stretch"
                              Background="Transparent">
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <Border Background="Transparent">
                                            <ContentPresenter />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ToggleButton.Style>
                </ToggleButton>
                <TextBox x:Name="PART_TextFilterInput" BorderThickness="0"
                         VerticalAlignment="Center" Margin="1,0,30,0"/>
                <Button x:Name="PART_ButtonClearFilter"
                        Margin="0,0,30,0" FontSize="18" Foreground="{DynamicResource Blastlog.TextMuted}"
                        Background="Transparent" HorizontalAlignment="Right"
                        BorderThickness="0" Padding="3,0,3,0"
                        ContentTemplate="{DynamicResource ClearTextIconTemplate}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="MinWidth" Value="0" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMouseOver, ElementName=Root}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Popup Placement="Bottom" Focusable="False" AllowsTransparency="True" Name="Popup"
                       IsOpen="{Binding IsChecked, ElementName=MainToggle, Mode=TwoWay, Delay=100}" StaysOpen="False"
                       MaxHeight="420" MinWidth="{Binding ActualWidth, ElementName=MainToggle}">
                    <Border Background="{DynamicResource Blastlog.Surface}" CornerRadius="14" Padding="0,6" Margin="0,6,12,12"
                            BorderThickness="1" BorderBrush="{DynamicResource Blastlog.Line}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.35" Color="Black" />
                        </Border.Effect>
                        <ItemsControl x:Name="PART_ItemsPanel" />
                    </Border>
                </Popup>
            </Grid>
        </Border>
    </ControlTemplate>

    <Style x:Key="FilterSelectionBoxItemStyle" TargetType="CheckBox">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{DynamicResource Blastlog.Text}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Margin" Value="6,2" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource Blastlog.FocusRing}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Fill" CornerRadius="10" Background="{TemplateBinding Background}">
                        <ContentPresenter Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fill" Property="Background" Value="{DynamicResource Blastlog.Surface2}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Fill" Property="Background" Value="{DynamicResource Blastlog.Game}" />
                            <Setter Property="Foreground" Value="{DynamicResource Blastlog.OnGame}" />
                            <Setter Property="FontWeight" Value="Bold" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="Fill" Property="Background" Value="{DynamicResource Blastlog.GameTint2}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type FilterEnumSelectionBox}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Template" Value="{DynamicResource FilterSelectionBoxTemplate}" />
    </Style>
    
    <Style TargetType="{x:Type FilterStringSelectionBox}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Template" Value="{DynamicResource FilterSelectionBoxTemplate}" />
    </Style>

    <Style TargetType="{x:Type FilterSelectionBox}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Template" Value="{DynamicResource FilterSelectionBoxTemplate}" />
    </Style>
</ResourceDictionary>