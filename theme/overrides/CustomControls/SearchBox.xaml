<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!--
      Blastlog's search field (the site's Library search, design.md 7 "Search"): surface with a line edge, radius 13,
      the magnifier in muted text, the clear button on the right; focus turns the edge to the game colour with a soft
      ring. Based on Playnite's default theme (MIT, see CREDITS.md); PART_SeachIcon, PART_TextInpuText and
      PART_ClearTextIcon are kept (Playnite wires them).
    -->
    <Style x:Key="Blastlog.SearchInput" TargetType="TextBox">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource Blastlog.Text}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Blastlog.Text}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Blastlog.Game}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="None" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="Transparent">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type SearchBox}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type SearchBox}">
                    <Grid>
                        <Border x:Name="Glow" CornerRadius="15" Margin="-2" BorderThickness="2" BorderBrush="Transparent" />
                        <Border x:Name="Field" CornerRadius="13" BorderThickness="1"
                                Background="{DynamicResource Blastlog.Surface}" BorderBrush="{DynamicResource Blastlog.Line}" />
                        <ContentControl x:Name="PART_SeachIcon"
                                        ContentTemplate="{DynamicResource SearchTextIconTemplate}"
                                        VerticalAlignment="Center" HorizontalAlignment="Left" Margin="14,0,0,0"
                                        Focusable="False" IsTabStop="False"
                                        Foreground="{DynamicResource Blastlog.TextMuted}" />
                        <TextBox x:Name="PART_TextInpuText" Style="{StaticResource Blastlog.SearchInput}"
                                 VerticalContentAlignment="Center" Padding="40,0,36,0"/>
                        <ContentControl x:Name="PART_ClearTextIcon"
                                        ContentTemplate="{DynamicResource ClearTextIconTemplate}" Cursor="Hand"
                                        FontSize="18" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,0"
                                        Focusable="False" IsTabStop="False"
                                        Foreground="{DynamicResource Blastlog.TextMuted}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource Blastlog.Edge}" />
                        </Trigger>
                        <Trigger SourceName="PART_TextInpuText" Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource Blastlog.Game}" />
                            <Setter TargetName="Glow" Property="BorderBrush" Value="{DynamicResource Blastlog.GameEdge}" />
                        </Trigger>
                        <Trigger SourceName="PART_ClearTextIcon" Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_ClearTextIcon" Property="Foreground" Value="{DynamicResource Blastlog.Text}" />
                        </Trigger>
                        <Trigger Property="ShowImage" Value="False">
                            <Setter TargetName="PART_TextInpuText" Property="Padding" Value="14,0,36,0" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
