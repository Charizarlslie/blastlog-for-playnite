<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:pbeh="clr-namespace:Playnite.Behaviors;assembly=Playnite"
                    mc:Ignorable="d">
    <!--
      Blastlog's game page in the grid view's side panel (Blastlog design.md 8), from Playnite's default (MIT): title,
      Playnite's Play / Install, Blastlog's status and stars, then the plugin's game page and Playnite's own details in
      Blastlog's cards. The same elements as the details view, stacked for the narrow panel. Every PART_ element is kept.
    -->
    <Style TargetType="{x:Type GridViewGameOverview}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GridViewGameOverview}">
                    <ControlTemplate.Resources>
                        <!-- Buttons in the action row (design.md 7): primary in the game's colour, the rest ghost; 46px, radius 12. -->
                        <ControlTemplate x:Key="BlastlogHeroButton" TargetType="Button">
                            <Grid>
                                <Border x:Name="Fill" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" />
                                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" RecognizesAccessKey="True" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Fill" Property="Opacity" Value="0.88" /></Trigger>
                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="Fill" Property="Opacity" Value="0.75" /></Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                        <Style x:Key="BlastlogHeroPrimary" TargetType="Button">
                            <Setter Property="Template" Value="{StaticResource BlastlogHeroButton}" />
                            <Setter Property="Background" Value="{DynamicResource Blastlog.Game}" />
                            <Setter Property="Foreground" Value="{DynamicResource Blastlog.OnGame}" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="FontFamily" Value="{DynamicResource Blastlog.Font}" />
                            <Setter Property="FontSize" Value="16" />
                            <Setter Property="FontWeight" Value="Bold" />
                            <Setter Property="MinHeight" Value="48" />
                            <Setter Property="MinWidth" Value="140" />
                            <Setter Property="Padding" Value="24,0" />
                            <Setter Property="Margin" Value="0,0,10,10" />
                            <Setter Property="Cursor" Value="Hand" />
                        </Style>
                        <Style x:Key="BlastlogHeroGhost" TargetType="Button" BasedOn="{StaticResource BlastlogHeroPrimary}">
                            <Setter Property="Background" Value="{DynamicResource Blastlog.Surface}" />
                            <Setter Property="Foreground" Value="{DynamicResource Blastlog.Text}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource Blastlog.Edge}" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="MinWidth" Value="48" />
                            <Setter Property="Padding" Value="18,0" />
                        </Style>
                        <Style x:Key="BlastlogCard" TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource Blastlog.Surface}" />
                            <Setter Property="CornerRadius" Value="22" />
                            <Setter Property="Padding" Value="22" />
                            <Setter Property="Margin" Value="0,0,0,18" />
                        </Style>
                        <Style x:Key="BlastlogCardTitle" TargetType="TextBlock">
                            <Setter Property="FontFamily" Value="{DynamicResource Blastlog.Font}" />
                            <Setter Property="FontSize" Value="20" />
                            <Setter Property="FontWeight" Value="ExtraBold" />
                            <Setter Property="Foreground" Value="{DynamicResource Blastlog.Text}" />
                            <Setter Property="Margin" Value="0,0,0,12" />
                        </Style>
                    </ControlTemplate.Resources>

                    <Border Padding="20,0,8,0" BorderBrush="{DynamicResource Blastlog.Line}" Background="{DynamicResource Blastlog.Bg}"
                            d:DataContext="{x:Static DesignMainViewModel.DesignSelectedGameDetailsIntance}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderThickness" Value="1,0,0,0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Settings GridViewDetailsPosition}" Value="Left">
                                        <Setter Property="BorderThickness" Value="0,0,1,0" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Settings ShowPanelSeparators}" Value="False">
                                        <Setter Property="BorderThickness" Value="0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <DockPanel>
                            <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Content="r" FontFamily="Marlett"
                                    Style="{DynamicResource SimpleButton}"
                                    Foreground="{DynamicResource Blastlog.TextMuted}"
                                    Command="{MainViewModel CloseGameSideBarCommand}"
                                    DockPanel.Dock="Top" Margin="0,12,12,4" MinWidth="44" MinHeight="44" />

                            <TextBlock Text="{DynamicResource LOCErrorNoGameSelected}"
                                       Margin="0,20,0,0" DockPanel.Dock="Top"
                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Setter Property="Foreground" Value="{DynamicResource Blastlog.TextMuted}" />
                                        <Style.Triggers>
                                            <Trigger Property="DataContext" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <DockPanel DockPanel.Dock="Top">
                                <DockPanel.Style>
                                    <Style TargetType="DockPanel">
                                        <Style.Triggers>
                                            <Trigger Property="DataContext" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DockPanel.Style>

                                <DockPanel DockPanel.Dock="Top" Margin="0,0,12,0">
                                    <Image Name="PART_ImageIcon" DockPanel.Dock="Left" MaxHeight="32" MaxWidth="32"
                                           RenderOptions.BitmapScalingMode="Fant" Margin="0,0,12,0" />
                                    <TextBlock Name="PART_TextDisplayName" FontFamily="{DynamicResource Blastlog.Font}"
                                               FontSize="30" FontWeight="ExtraBold" TextWrapping="Wrap" DockPanel.Dock="Left"
                                               VerticalAlignment="Center" Foreground="{DynamicResource Blastlog.Text}" />
                                </DockPanel>

                                <WrapPanel DockPanel.Dock="Top" Margin="0,16,12,8" Orientation="Horizontal">
                                    <Button Name="PART_ButtonPlayAction" Style="{StaticResource BlastlogHeroPrimary}" />
                                    <Button Name="PART_ButtonContextAction" Style="{StaticResource BlastlogHeroPrimary}" />
                                    <Button Name="PART_ButtonMoreActions" Style="{StaticResource BlastlogHeroGhost}"
                                            Content="{DynamicResource LOCMoreAction}" />
                                    <Button x:Name="PART_ButtonEditGame" Style="{StaticResource BlastlogHeroGhost}"
                                            Focusable="False" Content="&#xeded;" FontFamily="{DynamicResource FontIcoFont}" FontWeight="Normal" />
                                </WrapPanel>

                                <ScrollViewer DockPanel.Dock="Top" HorizontalAlignment="Stretch"
                                              HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                              x:Name="PART_ScrollViewHost">
                                    <StackPanel Margin="0,0,12,16">
                                        <ContentControl x:Name="Blastlog_GameActions" Margin="0,0,0,16" />
                                        <ContentControl x:Name="Blastlog_GamePage" />
                                        <!-- Playnite's own extras, in the same cards. -->
                                        <Border Style="{StaticResource BlastlogCard}">
                                            <StackPanel>
                                                <StackPanel.Resources>
                                                    <Style TargetType="ItemsControl">
                                                        <Setter Property="VerticalAlignment" Value="Center" />
                                                    </Style>
                                                    <Style TargetType="Label" BasedOn="{StaticResource {x:Type Label}}">
                                                        <Setter Property="Margin" Value="0,5,18,5" />
                                                        <Setter Property="VerticalAlignment" Value="Top" />
                                                        <Setter Property="Foreground" Value="{DynamicResource Blastlog.TextMuted}" />
                                                        <Setter Property="FontSize" Value="15" />
                                                    </Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource PropertyItemButton}" />
                                                </StackPanel.Resources>
                                                <TextBlock Text="{DynamicResource LOCGameDetails}" Style="{StaticResource BlastlogCardTitle}" />
                                                <GridEx ColumnCount="2" StarColumns="1"
                                                        RowCount="25" AutoLayoutColumns="2">
                                                    <Grid.Resources>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
                                                            <Setter Property="Foreground" Value="{DynamicResource Blastlog.Text}" />
                                                            <Setter Property="FontSize" Value="15" />
                                                        </Style>
                                                    </Grid.Resources>

                                                    <Label Name="PART_ElemAdded" Content="{DynamicResource LOCDateAddedLabel}" />
                                                    <TextBlock Name="PART_TextAdded" VerticalAlignment="Center" TextWrapping="Wrap" />

                                                    <Label Name="PART_ElemPlayTime" Content="{DynamicResource LOCTimePlayed}" />
                                                    <TextBlock Name="PART_TextPlayTime" VerticalAlignment="Center" TextWrapping="Wrap" />

                                                    <Label Name="PART_ElemLastPlayed" Content="{DynamicResource LOCLastPlayed}" />
                                                    <TextBlock Name="PART_TextLastActivity" VerticalAlignment="Center" TextWrapping="Wrap" />


                                                    <Label Name="PART_ElemCompletionStatus" Content="{DynamicResource LOCCompletionStatus}" />
                                                    <Button Name="PART_ButtonCompletionStatus" VerticalAlignment="Center" />

                                                    <Label Name="PART_ElemInstallDirectory" Content="{DynamicResource LOCGameInstallDirTitle}" />
                                                    <Button Name="PART_ButtonInstallDirectory" VerticalAlignment="Center" />

                                                    <Label Name="PART_ElemInstallSize" Content="{DynamicResource LOCInstallSizeLabel}" />
                                                    <TextBlock Name="PART_TextInstallSize" VerticalAlignment="Center" TextWrapping="Wrap" />

                                                    <Label Name="PART_ElemLibrary" Content="{DynamicResource LOCGameProviderTitle}" />
                                                    <Button Name="PART_ButtonLibrary" VerticalAlignment="Center" />

                                                    <Label Name="PART_ElemPlatform" Content="{DynamicResource LOCPlatformTitle}" />
                                                    <ItemsControl Name="PART_ItemsPlatforms" />

                                                    <Label Name="PART_ElemGenres" Content="{DynamicResource LOCGenreLabel}" />
                                                    <ItemsControl Name="PART_ItemsGenres" />

                                                    <Label Name="PART_ElemDevelopers" Content="{DynamicResource LOCDeveloperLabel}" />
                                                    <ItemsControl Name="PART_ItemsDevelopers" />

                                                    <Label Name="PART_ElemPublishers" Content="{DynamicResource LOCPublisherLabel}" />
                                                    <ItemsControl Name="PART_ItemsPublishers" />

                                                    <Label Name="PART_ElemReleaseDate" Content="{DynamicResource LOCGameReleaseDateTitle}" />
                                                    <Button Name="PART_ButtonReleaseDate" VerticalAlignment="Center" />

                                                    <Label Name="PART_ElemCategories" Content="{DynamicResource LOCGameCategoriesTitle}" />
                                                    <ItemsControl Name="PART_ItemsCategories" />

                                                    <Label Name="PART_ElemFeatures" Content="{DynamicResource LOCFeaturesLabel}" />
                                                    <ItemsControl Name="PART_ItemsFeatures" />

                                                    <Label Name="PART_ElemTags" Content="{DynamicResource LOCTagsLabel}" />
                                                    <ItemsControl Name="PART_ItemsTags" />

                                                    <Label Name="PART_ElemAgeRating" Content="{DynamicResource LOCAgeRatingLabel}" />
                                                    <ItemsControl Name="PART_ItemsAgeRatings" />

                                                    <Label Name="PART_ElemSeries" Content="{DynamicResource LOCSeriesLabel}" />
                                                    <ItemsControl Name="PART_ItemsSeries" />

                                                    <Label Name="PART_ElemSource" Content="{DynamicResource LOCSourceLabel}" />
                                                    <Button Name="PART_ButtonSource" VerticalAlignment="Center" />

                                                    <Label Name="PART_ElemRegion" Content="{DynamicResource LOCRegionLabel}" />
                                                    <ItemsControl Name="PART_ItemsRegions" />

                                                    <Label Name="PART_ElemVersion" Content="{DynamicResource LOCVersionLabel}" />
                                                    <Button Name="PART_ButtonVersion" VerticalAlignment="Center" />

                                                    <Label Name="PART_ElemCommunityScore" Content="{DynamicResource LOCCommunityScore}" />
                                                    <TextBlock Name="PART_TextCommunityScore" VerticalAlignment="Center"
                                                               Style="{DynamicResource TextBlockGameScore}" />

                                                    <Label Name="PART_ElemCriticScore" Content="{DynamicResource LOCCriticScore}" />
                                                    <TextBlock Name="PART_TextCriticScore" VerticalAlignment="Center"
                                                               Style="{DynamicResource TextBlockGameScore}" />

                                                    <Label Name="PART_ElemUserScore" Content="{DynamicResource LOCUserScore}" />
                                                    <TextBlock Name="PART_TextUserScore" VerticalAlignment="Center"
                                                               Style="{DynamicResource TextBlockGameScore}" />

                                                    <Label Name="PART_ElemLinks" Content="{DynamicResource LOCLinksLabel}" />
                                                    <ItemsControl Name="PART_ItemsLinks" />
                                                </GridEx>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource BlastlogCard}">
                                            <StackPanel>
                                                <StackPanel Name="PART_ElemNotes" Margin="0,0,0,18">
                                                    <TextBlock Text="{DynamicResource LOCNotesLabel}" Style="{StaticResource BlastlogCardTitle}" />
                                                    <TextBox Name="PART_TextNotes" IsReadOnly="True"
                                                             BorderThickness="0" Background="Transparent"
                                                             Foreground="{DynamicResource Blastlog.Text}" FontSize="16"
                                                             AcceptsReturn="True" TextWrapping="Wrap"
                                                             Margin="-1,0,-1,0" Padding="0" />
                                                </StackPanel>
                                                <StackPanel Name="PART_ElemDescription">
                                                    <TextBlock Text="{DynamicResource LOCGameDescriptionTitle}" Style="{StaticResource BlastlogCardTitle}" />
                                                    <HtmlTextView Name="PART_HtmlDescription"
                                                                  HtmlFontSize="16"
                                                                  HtmlFontFamily="{DynamicResource Blastlog.Font}"
                                                                  HtmlForeground="{DynamicResource TextColor}"
                                                                  LinkForeground="{DynamicResource GlyphColor}"
                                                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                                  ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                                  pbeh:FocusBahaviors.BlockBringIntoViewRequest="True" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </DockPanel>
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
