<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:pbeh="clr-namespace:Playnite.Behaviors;assembly=Playnite"
                    mc:Ignorable="d">
    <!--
      Blastlog's game page (Blastlog design.md 8 and docs/PLAYNITE_DESIGN.md 4.3), from Playnite's default details view
      (MIT): the blurred background art under a scrim with the game's glow, the cover beside the title, the action row with
      Playnite's Play / Install first and Blastlog's status and stars after it (Blastlog_GameActions), then the plugin's
      game page (Blastlog_GamePage: fingerprint, For you, your take, friends, where you own it, More like this, history)
      and Playnite's own details, notes and description underneath in the same cards. Every PART_ element Playnite wires
      is kept. Colours are Blastlog.* tokens only, so Blastlog and Blastlog Light both work.
    -->
    <Style TargetType="{x:Type DetailsViewGameOverview}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DetailsViewGameOverview}">
                    <ControlTemplate.Resources>
                        <!-- Buttons in the action row (design.md 7): primary in the game's colour, the rest ghost; 46px, radius 12. -->
                        <ControlTemplate x:Key="BlastlogHeroButton" TargetType="Button">
                            <Grid>
                                <Border x:Name="Fill" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" />
                                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" RecognizesAccessKey="True" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Fill" Property="Opacity" Value="0.88" /></Trigger>
                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="Fill" Property="Opacity" Value="0.75" /></Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                        <Style x:Key="BlastlogHeroPrimary" TargetType="Button">
                            <Setter Property="Template" Value="{StaticResource BlastlogHeroButton}" />
                            <Setter Property="Background" Value="{DynamicResource Blastlog.Game}" />
                            <Setter Property="Foreground" Value="{DynamicResource Blastlog.OnGame}" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="FontFamily" Value="{DynamicResource Blastlog.Font}" />
                            <Setter Property="FontSize" Value="16" />
                            <Setter Property="FontWeight" Value="Bold" />
                            <Setter Property="MinHeight" Value="48" />
                            <Setter Property="MinWidth" Value="140" />
                            <Setter Property="Padding" Value="24,0" />
                            <Setter Property="Margin" Value="0,0,10,10" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="FocusVisualStyle" Value="{DynamicResource Blastlog.FocusRing}" />
                            <Setter Property="VerticalAlignment" Value="Top" />
                        </Style>
                        <Style x:Key="BlastlogHeroGhost" TargetType="Button" BasedOn="{StaticResource BlastlogHeroPrimary}">
                            <Setter Property="Background" Value="{DynamicResource Blastlog.Surface}" />
                            <Setter Property="Foreground" Value="{DynamicResource Blastlog.Text}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource Blastlog.Edge}" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="MinWidth" Value="48" />
                            <Setter Property="Padding" Value="18,0" />
                        </Style>
                        <Style x:Key="BlastlogCard" TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource Blastlog.Surface}" />
                            <Setter Property="CornerRadius" Value="22" />
                            <Setter Property="Padding" Value="22" />
                            <Setter Property="Margin" Value="0,0,0,18" />
                        </Style>
                        <Style x:Key="BlastlogCardTitle" TargetType="TextBlock">
                            <Setter Property="FontFamily" Value="{DynamicResource Blastlog.Font}" />
                            <Setter Property="FontSize" Value="20" />
                            <Setter Property="FontWeight" Value="ExtraBold" />
                            <Setter Property="Foreground" Value="{DynamicResource Blastlog.Text}" />
                            <Setter Property="Margin" Value="0,0,0,12" />
                        </Style>
                    </ControlTemplate.Resources>

                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto"
                                  Style="{DynamicResource DetailsScrollViewer}"
                                  Background="{DynamicResource Blastlog.Bg}"
                                  d:DesignWidth="1280"
                                  d:DesignHeight="1280"
                                  d:DataContext="{x:Static DesignMainViewModel.DesignSelectedGameDetailsIntance}"
                                  x:Name="PART_ScrollViewHost">
                        <Grid>
                            <!-- Atmosphere: the art blurred under a scrim (light mode lightens it), and the game's glow. -->
                            <!-- Pinned to the visible width: the art fills by height, and would otherwise widen the whole page. -->
                            <Grid Height="640" VerticalAlignment="Top" HorizontalAlignment="Left" ClipToBounds="True" IsHitTestVisible="False"
                                  Width="{Binding ViewportWidth, ElementName=PART_ScrollViewHost}">
                                <FadeImage x:Name="PART_ImageBackground" Stretch="UniformToFill"
                                           HorizontalAlignment="Center" VerticalAlignment="Top" Opacity="0.6">
                                    <FadeImage.Effect>
                                        <BlurEffect Radius="48" KernelType="Gaussian" RenderingBias="Performance" />
                                    </FadeImage.Effect>
                                    <!-- The art fades out before the backdrop ends, so its bottom edge never shows (Blastlog Light showed a hard line). -->
                                    <FadeImage.OpacityMask>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#FF000000" Offset="0" />
                                            <GradientStop Color="#FF000000" Offset="0.35" />
                                            <GradientStop Color="#00000000" Offset="0.9" />
                                        </LinearGradientBrush>
                                    </FadeImage.OpacityMask>
                                </FadeImage>
                                <Rectangle Fill="{DynamicResource Blastlog.Bg}">
                                    <Rectangle.OpacityMask>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#8C000000" Offset="0" />
                                            <GradientStop Color="#B3000000" Offset="0.45" />
                                            <GradientStop Color="#FF000000" Offset="1" />
                                        </LinearGradientBrush>
                                    </Rectangle.OpacityMask>
                                </Rectangle>
                                <Rectangle>
                                    <Rectangle.Fill>
                                        <RadialGradientBrush Center="0.22,0.32" GradientOrigin="0.22,0.32" RadiusX="0.55" RadiusY="0.7">
                                            <GradientStop Color="{DynamicResource Blastlog.GlowColor}" Offset="0" />
                                            <GradientStop Color="{DynamicResource Blastlog.GlowClearColor}" Offset="0.66" />
                                        </RadialGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                            </Grid>

                            <StackPanel MaxWidth="1180" Margin="40,0,40,24">
                                <!-- The hero: cover beside the title and the action row. -->
                                <Grid Margin="0,64,0,30">
                                    <Grid.ColumnDefinitions>
                                        <!-- The cover takes up to 232px plus its gap, and shrinks with a narrow pane so the title keeps its room. -->
                                        <ColumnDefinition Width="0.42*" MaxWidth="264" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid MaxWidth="232" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="0,0,24,0">
                                        <Grid.Effect>
                                            <DropShadowEffect ShadowDepth="10" BlurRadius="36" Opacity="0.45" />
                                        </Grid.Effect>
                                        <Border x:Name="CoverMask" CornerRadius="18" Background="White" />
                                        <Image Name="PART_ImageCover" Stretch="Uniform" StretchDirection="Both"
                                               RenderOptions.BitmapScalingMode="Fant">
                                            <Image.OpacityMask>
                                                <VisualBrush Visual="{Binding ElementName=CoverMask}" />
                                            </Image.OpacityMask>
                                        </Image>
                                    </Grid>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Bottom">
                                        <DockPanel>
                                            <Image Name="PART_ImageIcon" MaxHeight="40" MaxWidth="40"
                                                   DockPanel.Dock="Left" Margin="0,0,14,0"
                                                   VerticalAlignment="Center"
                                                   RenderOptions.BitmapScalingMode="Fant" />
                                            <TextBlock Name="PART_TextDisplayName" FontFamily="{DynamicResource Blastlog.Font}"
                                                       FontSize="46" FontWeight="ExtraBold" TextWrapping="Wrap"
                                                       VerticalAlignment="Center" LineHeight="52" LineStackingStrategy="BlockLineHeight"
                                                       Foreground="{DynamicResource Blastlog.Text}" />
                                        </DockPanel>
                                        <WrapPanel Margin="0,22,0,0" Orientation="Horizontal">
                                            <Button Name="PART_ButtonPlayAction" Style="{DynamicResource PlayButton}" VerticalAlignment="Top" FontSize="16" MinWidth="140" Padding="24,0" Margin="0,0,10,10" />
                                            <Button Name="PART_ButtonContextAction" Style="{DynamicResource PlayButton}" VerticalAlignment="Top" FontSize="16" MinWidth="140" Padding="24,0" Margin="0,0,10,10" />
                                            <Button Name="PART_ButtonMoreActions" Style="{StaticResource BlastlogHeroGhost}"
                                                    Content="{DynamicResource LOCMoreAction}" />
                                            <Button x:Name="PART_ButtonEditGame" Style="{StaticResource BlastlogHeroGhost}"
                                                    Focusable="False" ToolTip="{DynamicResource LOCEditGame}"
                                                    Content="&#xeded;" FontFamily="{DynamicResource FontIcoFont}" FontWeight="Normal" />
                                            <ContentControl x:Name="Blastlog_GameActions" Margin="4,0,0,10" VerticalAlignment="Center" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Grid>

                                <!-- Blastlog's game page. -->
                                <ContentControl x:Name="Blastlog_GamePage" />

                                <!-- Playnite's own extras, in the same cards. -->
                                <Border Style="{StaticResource BlastlogCard}">
                                    <StackPanel>
                                        <StackPanel.Resources>
                                            <Style TargetType="ItemsControl">
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                            </Style>
                                            <Style TargetType="Label" BasedOn="{StaticResource {x:Type Label}}">
                                                <Setter Property="Margin" Value="0,5,18,5" />
                                                <Setter Property="VerticalAlignment" Value="Top" />
                                                <Setter Property="Foreground" Value="{DynamicResource Blastlog.TextMuted}" />
                                                <Setter Property="FontSize" Value="15" />
                                            </Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource PropertyItemButton}" />
                                        </StackPanel.Resources>
                                        <TextBlock Text="{DynamicResource LOCGameDetails}" Style="{StaticResource BlastlogCardTitle}" />
                                        <GridEx ColumnCount="2" StarColumns="1"
                                                RowCount="25" AutoLayoutColumns="2">
                                            <Grid.Resources>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
                                                    <Setter Property="Foreground" Value="{DynamicResource Blastlog.Text}" />
                                                    <Setter Property="FontSize" Value="15" />
                                                </Style>
                                            </Grid.Resources>

                                            <Label Name="PART_ElemAdded" Content="{DynamicResource LOCDateAddedLabel}" />
                                            <TextBlock Name="PART_TextAdded" VerticalAlignment="Center" TextWrapping="Wrap" />

                                            <Label Name="PART_ElemPlayTime" Content="{DynamicResource LOCTimePlayed}" />
                                            <TextBlock Name="PART_TextPlayTime" VerticalAlignment="Center" TextWrapping="Wrap" />

                                            <Label Name="PART_ElemLastPlayed" Content="{DynamicResource LOCLastPlayed}" />
                                            <TextBlock Name="PART_TextLastActivity" VerticalAlignment="Center" TextWrapping="Wrap" />

                                            <Label Name="PART_ElemRecentActivity" Content="{DynamicResource LOCRecentActivityLabel}" />
                                            <TextBlock Name="PART_TextRecentActivity" VerticalAlignment="Center" TextWrapping="Wrap" />

                                            <Label Name="PART_ElemCompletionStatus" Content="{DynamicResource LOCCompletionStatus}" />
                                            <Button Name="PART_ButtonCompletionStatus" VerticalAlignment="Center" />

                                            <Label Name="PART_ElemInstallDirectory" Content="{DynamicResource LOCGameInstallDirTitle}" />
                                            <Button Name="PART_ButtonInstallDirectory" VerticalAlignment="Center" />

                                            <Label Name="PART_ElemInstallSize" Content="{DynamicResource LOCInstallSizeLabel}" />
                                            <TextBlock Name="PART_TextInstallSize" VerticalAlignment="Center" TextWrapping="Wrap" />

                                            <Label Name="PART_ElemLibrary" Content="{DynamicResource LOCGameProviderTitle}" />
                                            <Button Name="PART_ButtonLibrary" VerticalAlignment="Center" />

                                            <Label Name="PART_ElemPlatform" Content="{DynamicResource LOCPlatformTitle}" />
                                            <ItemsControl Name="PART_ItemsPlatforms" />

                                            <Label Name="PART_ElemGenres" Content="{DynamicResource LOCGenreLabel}" />
                                            <ItemsControl Name="PART_ItemsGenres" />

                                            <Label Name="PART_ElemDevelopers" Content="{DynamicResource LOCDeveloperLabel}" />
                                            <ItemsControl Name="PART_ItemsDevelopers" />

                                            <Label Name="PART_ElemPublishers" Content="{DynamicResource LOCPublisherLabel}" />
                                            <ItemsControl Name="PART_ItemsPublishers" />

                                            <Label Name="PART_ElemReleaseDate" Content="{DynamicResource LOCGameReleaseDateTitle}" />
                                            <Button Name="PART_ButtonReleaseDate" VerticalAlignment="Center" />

                                            <Label Name="PART_ElemCategories" Content="{DynamicResource LOCGameCategoriesTitle}" />
                                            <ItemsControl Name="PART_ItemsCategories" />

                                            <Label Name="PART_ElemFeatures" Content="{DynamicResource LOCFeaturesLabel}" />
                                            <ItemsControl Name="PART_ItemsFeatures" />

                                            <Label Name="PART_ElemTags" Content="{DynamicResource LOCTagsLabel}" />
                                            <ItemsControl Name="PART_ItemsTags" />

                                            <Label Name="PART_ElemAgeRating" Content="{DynamicResource LOCAgeRatingLabel}" />
                                            <ItemsControl Name="PART_ItemsAgeRatings" />

                                            <Label Name="PART_ElemSeries" Content="{DynamicResource LOCSeriesLabel}" />
                                            <ItemsControl Name="PART_ItemsSeries" />

                                            <Label Name="PART_ElemSource" Content="{DynamicResource LOCSourceLabel}" />
                                            <Button Name="PART_ButtonSource" VerticalAlignment="Center" />

                                            <Label Name="PART_ElemRegion" Content="{DynamicResource LOCRegionLabel}" />
                                            <ItemsControl Name="PART_ItemsRegions" />

                                            <Label Name="PART_ElemVersion" Content="{DynamicResource LOCVersionLabel}" />
                                            <Button Name="PART_ButtonVersion" VerticalAlignment="Center" />

                                            <Label Name="PART_ElemCommunityScore" Content="{DynamicResource LOCCommunityScore}" />
                                            <TextBlock Name="PART_TextCommunityScore" VerticalAlignment="Center"
                                                       Style="{DynamicResource TextBlockGameScore}" />

                                            <Label Name="PART_ElemCriticScore" Content="{DynamicResource LOCCriticScore}" />
                                            <TextBlock Name="PART_TextCriticScore" VerticalAlignment="Center"
                                                       Style="{DynamicResource TextBlockGameScore}" />

                                            <Label Name="PART_ElemUserScore" Content="{DynamicResource LOCUserScore}" />
                                            <TextBlock Name="PART_TextUserScore" VerticalAlignment="Center"
                                                       Style="{DynamicResource TextBlockGameScore}" />

                                            <Label Name="PART_ElemLinks" Content="{DynamicResource LOCLinksLabel}" />
                                            <ItemsControl Name="PART_ItemsLinks" />
                                        </GridEx>
                                    </StackPanel>
                                </Border>

                                <Border>
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource BlastlogCard}">
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemNotes}" Value="Collapsed" />
                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemDescription}" Value="Collapsed" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    <StackPanel>
                                        <StackPanel Name="PART_ElemNotes" Margin="0,0,0,18">
                                            <TextBlock Text="{DynamicResource LOCNotesLabel}" Style="{StaticResource BlastlogCardTitle}" />
                                            <TextBox Name="PART_TextNotes" IsReadOnly="True"
                                                     BorderThickness="0" Background="Transparent"
                                                     Foreground="{DynamicResource Blastlog.Text}" FontSize="16"
                                                     AcceptsReturn="True" TextWrapping="Wrap"
                                                     Margin="-1,0,-1,0" Padding="0" />
                                        </StackPanel>
                                        <StackPanel Name="PART_ElemDescription">
                                            <TextBlock Text="{DynamicResource LOCGameDescriptionTitle}" Style="{StaticResource BlastlogCardTitle}" />
                                            <HtmlTextView Name="PART_HtmlDescription"
                                                          HtmlFontSize="16"
                                                          HtmlFontFamily="{DynamicResource Blastlog.Font}"
                                                          HtmlForeground="{DynamicResource TextColor}"
                                                          LinkForeground="{DynamicResource GlyphColor}"
                                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                          ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                          pbeh:FocusBahaviors.BlockBringIntoViewRequest="True" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
