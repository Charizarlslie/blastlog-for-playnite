<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d">
    <!--
      Playnite's filter panel as Blastlog's filters (docs/PLAYNITE_DESIGN.md 4.2; the site's .filter-row): the on/off
      filters are chips (highlight only, no checkmark), the pick lists are 40px fields, labels are muted section heads.
      Based on Playnite's default theme (MIT, see CREDITS.md); every PART_ element and style key is kept.
    -->

    <Style x:Key="FilterPanelCheckBox" TargetType="CheckBox" BasedOn="{StaticResource Blastlog.ChipToggle}">
        <Setter Property="Margin" Value="16,4,12,6" />
    </Style>

    <Style x:Key="FilterPanelLabel" TargetType="Label" BasedOn="{StaticResource {x:Type Label}}">
        <Setter Property="Margin" Value="16,14,12,4" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource Blastlog.TextMuted}" />
        <Style.Triggers>
            <!-- A filter in use reads in text, the rest stay muted. -->
            <Trigger Property="Tag" Value="{StaticResource True}">
                <Setter Property="Foreground" Value="{DynamicResource Blastlog.Text}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="FilterPanelFilterSearchBox" TargetType="SearchBox" BasedOn="{StaticResource {x:Type SearchBox}}">
        <Setter Property="Margin" Value="16,0,12,0" />
        <Setter Property="ShowImage" Value="False" />
    </Style>

    <Style x:Key="FilterPanelFilterSelectionBox" TargetType="FilterSelectionBox" BasedOn="{StaticResource {x:Type FilterSelectionBox}}">
        <Setter Property="Margin" Value="16,0,12,0" />
    </Style>

    <Style x:Key="FilterPanelFilterEnumSelectionBox" TargetType="FilterEnumSelectionBox" BasedOn="{StaticResource {x:Type FilterEnumSelectionBox}}">
        <Setter Property="Margin" Value="16,0,12,0" />
    </Style>

    <Style x:Key="FilterPanelFilterStringSelectionBox" TargetType="FilterStringSelectionBox" BasedOn="{StaticResource {x:Type FilterStringSelectionBox}}">
        <Setter Property="Margin" Value="16,0,12,0" />
    </Style>

    <Style x:Key="FilterPresetButtonAction" TargetType="Button" BasedOn="{StaticResource Blastlog.IconButton}">
        <Setter Property="FontFamily" Value="{StaticResource FontIcoFont}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Margin" Value="4,0,0,0" />
        <Setter Property="DockPanel.Dock" Value="Right" />
    </Style>

    <Style TargetType="{x:Type FilterPanel}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type FilterPanel}">
                    <Border BorderBrush="{DynamicResource Blastlog.Line}"
                            d:DesignWidth="200">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderThickness" Value="1,0,0,0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Settings FilterPanelPosition}" Value="Left">
                                        <Setter Property="BorderThickness" Value="0,0,1,0" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Settings ShowPanelSeparators}" Value="False">
                                        <Setter Property="BorderThickness" Value="0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <DockPanel Background="{DynamicResource Blastlog.Bg}">
                            <DockPanel Margin="16,16,12,8" DockPanel.Dock="Top">
                                <Button Style="{StaticResource Blastlog.IconButton}"
                                        DockPanel.Dock="Right" ToolTip="{DynamicResource LOCCloseLabel}"
                                        Name="PART_ButtonClose">
                                    <Viewbox Width="14" Height="14">
                                        <Canvas Width="24" Height="24">
                                            <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2.4"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M18 6 6 18 M6 6l12 12" />
                                        </Canvas>
                                    </Viewbox>
                                </Button>
                                <TextBlock Text="{DynamicResource LOCFilters}" DockPanel.Dock="Left" VerticalAlignment="Center"
                                           FontFamily="{DynamicResource FontFamily}" FontSize="18" FontWeight="ExtraBold"
                                           Foreground="{DynamicResource Blastlog.Text}" />
                                <Button DockPanel.Dock="Right" Content="{StaticResource LOCClearFilters}"
                                        HorizontalAlignment="Right" Margin="0,0,8,0"
                                        Style="{StaticResource SimpleButton}"
                                        Name="PART_ButtonClear"/>
                            </DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="16,0,12,8">
                                <Button x:Name="PART_ButtonDeleteFilter"
                                        Content="&#xec53;" Style="{DynamicResource FilterPresetButtonAction}" />
                                <Button x:Name="PART_ButtonRenameFilter"
                                        Content="&#xec55;" Style="{DynamicResource FilterPresetButtonAction}"/>
                                <Button x:Name="PART_ButtonSaveFilter"
                                        Content="&#xee00;" Style="{DynamicResource FilterPresetButtonAction}" />
                                <ComboBox x:Name="PART_ComboFilterPresets"
                                          DockPanel.Dock="Left" VerticalAlignment="Center" />
                            </DockPanel>
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                      DockPanel.Dock="Top" Padding="0,0,0,18">
                                <StackPanel x:Name="PART_PanelItemsHost" />
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
