<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    mc:Ignorable="d">
    <!--
      Based on Playnite's default theme (MIT, see CREDITS.md). Besides Playnite's Border style, this holds the theme's
      shared focus rings and icon button. Playnite checks each theme file on its own before applying the theme, so other
      files must use these as DynamicResource (a StaticResource or BasedOn to a key from another file fails the theme);
      styles that need BasedOn are defined in the file that uses them. Colours are Blastlog tokens only (Constants.xaml),
      so both Blastlog and Blastlog Light work.
    -->
    <Style TargetType="Border">
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- Blastlog's two-tone focus ring (design.md 7): 3px in focus with a 2px gap in bg. Keyboard focus only. -->
    <Style x:Key="Blastlog.FocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border CornerRadius="14" BorderThickness="3" Margin="-5" BorderBrush="{DynamicResource Blastlog.Focus}">
                        <Border CornerRadius="11" BorderThickness="2" BorderBrush="{DynamicResource Blastlog.Bg}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Blastlog.PillFocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border CornerRadius="999" BorderThickness="3" Margin="-5" BorderBrush="{DynamicResource Blastlog.Focus}">
                        <Border CornerRadius="999" BorderThickness="2" BorderBrush="{DynamicResource Blastlog.Bg}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      A filter chip (the site's .filter-row button and tap chips, design.md 16 "Tap chips, highlight only"): a pill with
      an edge border; on is the pill alone, game fill with on-game text and a 2px ring in text, no checkmark. The ring
      sits over the fill so nothing changes size.
    -->

    <!-- A row in a pick list (filter dropdowns): highlight only, game fill with on-game text when on, no checkmark. -->

    <!-- A quiet icon button on a bar (the site's search clear button and toolbar icons). -->
    <Style x:Key="Blastlog.IconButton" TargetType="Button">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource Blastlog.TextMuted}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="MinWidth" Value="36" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource Blastlog.FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Fill" CornerRadius="10" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fill" Property="Background" Value="{DynamicResource Blastlog.Line}" />
                            <Setter Property="Foreground" Value="{DynamicResource Blastlog.Text}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
