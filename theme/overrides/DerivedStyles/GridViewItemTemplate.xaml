<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d">
    <!--
      Blastlog's Library tile (docs/PLAYNITE_DESIGN.md 4.2; design.md 5, 7 and 9; the site's game-wearing tiles): a card
      in the game's tint and edge, radius 18, the 3:4 cover first, then the title (two lines, then cut off) and the
      Blastlog_Tile element, where the plugin puts the status pill and stars and gives the tile its own game colours
      (Ui/LibraryTint.cs). Without the plugin the tile wears the selected game's colours and shows no pill.
      The title always shows and the cover always fills its 3:4 box (the site's tiles), so Playnite's "show names
      under covers" and cover stretch settings don't apply here; its other grid settings do.
      Based on Playnite's default theme (MIT, see CREDITS.md); every PART_ element is kept.
    -->

    <!-- The round Play / Info buttons over the cover on hover. -->
    <Style x:Key="Blastlog.TilePlayButton" TargetType="Button">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Background" Value="{DynamicResource Blastlog.Game}" />
        <Setter Property="Foreground" Value="{DynamicResource Blastlog.OnGame}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Width" Value="52" />
        <Setter Property="Height" Value="52" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Ellipse x:Name="Fill" Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1" />
                        <TextBlock Text="{TemplateBinding Content}" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}"
                                   Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fill" Property="Opacity" Value="0.88" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Fill" Property="Opacity" Value="0.75" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Blastlog.TileInfoButton" TargetType="Button" BasedOn="{StaticResource Blastlog.TilePlayButton}">
        <Setter Property="Background" Value="{DynamicResource Blastlog.Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource Blastlog.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Blastlog.Edge}" />
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="FontSize" Value="18" />
    </Style>

    <Style x:Key="GridViewItemTemplate" TargetType="{x:Type GameListItem}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GameListItem}">
                    <!-- Playnite's item margin setting stays the space around each tile. -->
                    <Border BorderThickness="{Settings GridItemMargin}" BorderBrush="Transparent">
                        <Grid>
                            <!-- Selected (and hovered) tiles get a ring, in text like the focus ring, never the game's colour. -->
                            <Border x:Name="SelectionRing" CornerRadius="22" BorderThickness="3" Margin="-5"
                                    BorderBrush="Transparent" IsHitTestVisible="False" />
                            <Border x:Name="Tile" CornerRadius="18" BorderThickness="1"
                                    Background="{DynamicResource Blastlog.GameTint}"
                                    BorderBrush="{DynamicResource Blastlog.GameEdge}">
                                <StackPanel Name="PART_PanelHost" Background="Transparent"
                                            d:DataContext="{x:Static DesignMainViewModel.DesignSelectedGameIntance}">

                                    <!-- The cover box is 3:4 at Playnite's tile width (the Viewbox sizes it), with the card's top corners. -->
                                    <Grid Width="{Settings GridItemWidth}" x:Name="CoverArea" ClipToBounds="True">
                                        <Grid.OpacityMask>
                                            <VisualBrush Stretch="None" AlignmentX="Left" AlignmentY="Top">
                                                <VisualBrush.Visual>
                                                    <Border Background="Black" CornerRadius="17,17,0,0"
                                                            Width="{Binding ActualWidth, ElementName=CoverArea}"
                                                            Height="{Binding ActualHeight, ElementName=CoverArea}" />
                                                </VisualBrush.Visual>
                                            </VisualBrush>
                                        </Grid.OpacityMask>
                                        <!-- The sizer alone sets the box: Playnite's tile width, 4:3 tall (a layout transform, so no converter is needed). -->
                                        <Border x:Name="CoverSizer" IsHitTestVisible="False" VerticalAlignment="Top"
                                                Width="{Settings GridItemWidth}" Height="{Settings GridItemWidth}">
                                            <Border.LayoutTransform>
                                                <ScaleTransform ScaleX="1" ScaleY="1.3333333" />
                                            </Border.LayoutTransform>
                                        </Border>
                                        <Border Background="{DynamicResource Blastlog.GameTint2}" />
                                        <!-- The image sits in a canvas so it never sizes the box. The whole cover shows, centred: covers come in many shapes
                                             (2:3, 3:4, wide banners), and filling the box cut logos off; any space left over is the tile's own game tint. -->
                                        <Canvas>
                                            <Image Name="PART_ImageCover"
                                                   RenderOptions.BitmapScalingMode="Fant" StretchDirection="Both"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Width="{Binding ActualWidth, ElementName=CoverArea}"
                                                   Height="{Binding ActualHeight, ElementName=CoverArea}"
                                                   Stretch="Uniform" />
                                        </Canvas>
                                        <!-- No cover: the gamepad mark in Blastlog green and the title (design.md 9). -->
                                        <Border Background="{DynamicResource Blastlog.Surface2}" x:Name="TextGameName" Visibility="Collapsed">
                                            <StackPanel VerticalAlignment="Center" Margin="14">
                                                <Viewbox Width="40" Height="40" Margin="0,0,0,10">
                                                    <Canvas Width="24" Height="24">
                                                        <Path Stroke="{DynamicResource Blastlog.Brand}" StrokeThickness="2"
                                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                              Data="M6 12h4 M8 10v4 M15 13h.01 M18 11h.01 M17.32 5H6.68a4 4 0 0 0-3.978 3.59c-.006.052-.01.101-.017.152C2.604 9.416 2 14.456 2 16a3 3 0 0 0 3 3c1 0 1.5-.5 2-1l1.414-1.414A2 2 0 0 1 9.828 16h4.344a2 2 0 0 1 1.414.586L17 18c.5.5 1 1 2 1a3 3 0 0 0 3-3c0-1.545-.604-6.584-.685-7.258-.007-.05-.011-.1-.017-.151A4 4 0 0 0 17.32 5z" />
                                                    </Canvas>
                                                </Viewbox>
                                                <TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap" TextAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" MaxHeight="66"
                                                           FontFamily="{DynamicResource FontFamily}" FontSize="15" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Blastlog.Text}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Background="Black" Opacity="0.55" x:Name="BorderMouseOver" Visibility="Collapsed" />
                                        <Viewbox VerticalAlignment="Center" HorizontalAlignment="Center" StretchDirection="DownOnly"
                                                 Name="GameControls" Visibility="Collapsed">
                                            <StackPanel Orientation="Horizontal" Margin="10">
                                                <Button Name="PART_ButtonPlay" Style="{StaticResource Blastlog.TilePlayButton}"
                                                        Margin="0,0,10,0" VerticalAlignment="Center" ToolTip="{DynamicResource LOCPlayGame}"
                                                        Content="&#xec74;" FontFamily="{StaticResource FontIcoFont}" />
                                                <Button Name="PART_ButtonInfo" Style="{StaticResource Blastlog.TileInfoButton}"
                                                        VerticalAlignment="Center" ToolTip="{DynamicResource LOCGameDetails}"
                                                        Content="&#xef4f;" FontFamily="{StaticResource FontIcoFont}" />
                                            </StackPanel>
                                        </Viewbox>
                                    </Grid>

                                    <StackPanel Width="{Settings GridItemWidth}" Margin="0,10,0,12">
                                        <!-- Two lines, then cut off; the full title is in the accessible name (design.md 4). Playnite's grid gives every
                                             tile the same height, so the title always takes two lines' room and the info row one. -->
                                        <TextBlock Text="{Binding DisplayName}" x:Name="TitleText"
                                                   AutomationProperties.Name="{Binding DisplayName}"
                                                   FontFamily="{DynamicResource FontFamily}" FontSize="16" FontWeight="Bold"
                                                   Foreground="{DynamicResource Blastlog.Text}"
                                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                                   LineHeight="20" LineStackingStrategy="BlockLineHeight" Height="40"
                                                   Margin="12,0,12,0" />
                                        <!-- The info row: Installed (docs/PLAYNITE_DESIGN.md 4.2; kept off the cover so it never hides a
                                             logo), then the plugin's status pill and stars. One line: beside a status pill, Installed
                                             shrinks to its icon (its name and tooltip still say Installed). -->
                                        <StackPanel Margin="12,6,12,0" Orientation="Horizontal" Height="30" ClipToBounds="True">
                                            <Border x:Name="InstalledMark" Visibility="Collapsed" CornerRadius="999" Padding="10,4,12,4"
                                                    Margin="0,0,8,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                    ToolTip="Installed" AutomationProperties.Name="Installed"
                                                    Background="{DynamicResource Blastlog.Surface2}" BorderThickness="1"
                                                    BorderBrush="{DynamicResource Blastlog.Line}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Viewbox Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center">
                                                        <Canvas Width="24" Height="24">
                                                            <Path Stroke="{DynamicResource Blastlog.Ok}" StrokeThickness="2.4"
                                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                                  Data="M12 4v11 M7 10l5 5 5-5 M5 20h14" />
                                                        </Canvas>
                                                    </Viewbox>
                                                    <TextBlock Text="Installed" x:Name="InstalledWord" FontFamily="{DynamicResource FontFamily}" FontSize="14"
                                                               FontWeight="SemiBold" Foreground="{DynamicResource Blastlog.Text}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                            <ContentControl x:Name="Blastlog_Tile" Focusable="False" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsInstalled}" Value="False">
                            <Setter Property="Content" Value="&#xef08;" TargetName="PART_ButtonPlay" />
                            <Setter Property="ToolTip" Value="{DynamicResource LOCInstallGame}" TargetName="PART_ButtonPlay" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="InstalledMark" />
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsInstalled}" Value="False" />
                                <Condition Binding="{Settings DarkenUninstalledGamesGrid}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" TargetName="BorderMouseOver" />
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding CoverImage}" Value="{x:Null}" />
                                <Condition Binding="{Settings ShowNameEmptyCover}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" TargetName="TextGameName"/>
                        </MultiDataTrigger>
                        <DataTrigger Binding="{Binding Content.Visibility, ElementName=Blastlog_Tile}" Value="Visible">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="InstalledWord" />
                            <Setter Property="Padding" Value="7,4,1,4" TargetName="InstalledMark" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings ShowGridItemBackground}" Value="False">
                            <Setter Property="Background" Value="Transparent" TargetName="Tile" />
                            <Setter Property="BorderBrush" Value="Transparent" TargetName="Tile" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="BorderMouseOver"/>
                            <Setter Property="Visibility" Value="Visible" TargetName="GameControls"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource Blastlog.Edge}" TargetName="SelectionRing"/>
                        </Trigger>
                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource Blastlog.Focus}" TargetName="SelectionRing"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
